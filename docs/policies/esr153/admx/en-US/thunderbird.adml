<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources revision="153.0401" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName/>
  <description/>
  <resources>
    <stringTable>
      <string id="3rdparty_Extensions">Managed storage of extensions</string>
      <string id="3rdparty_Extensions_Explain">The managed storage of each extension, one JSON object per extension ID, which the extension reads with browser.storage.managed.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#3rdparty-policies-for-extensions
</string>
      <string id="AppAutoUpdate">Automatic updates</string>
      <string id="AppAutoUpdate_Explain">Enable or disable automatic application update.

Install application updates automatically. If this policy is enabled, updates are installed without asking the user (the operating system might still ask for approval). If it is disabled, updates are downloaded, and the user chooses when to install them. In both cases, the user can't change the setting. If updates are turned off with DisableAppUpdate, this policy has no effect.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#appautoupdate
</string>
      <string id="AppUpdatePin">Pin updates to a specific version</string>
      <string id="AppUpdatePin_Explain">Prevent Thunderbird from being updated beyond the specified version.

You can specify the version as xx. and Thunderbird will be updated with all minor versions, but will not be updated beyond the major version.

You can also specify the version as xx.xx and Thunderbird will be updated with all patch versions, but will not be updated beyond the minor version.

You should specify a version that exists or is guaranteed to exist. If you specify a version that doesn't end up existing, Thunderbird will update beyond that version.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#appupdatepin
</string>
      <string id="AppUpdateURL">Custom Update URL</string>
      <string id="AppUpdateURL_Explain">Set custom app update URL.

Change the URL for application update if you are providing Thunderbird updates from a custom update server.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#appupdateurl
</string>
      <string id="Authentication_SPNEGO">Sites allowed to use SPNEGO</string>
      <string id="Authentication_SPNEGO_Explain">Websites which may use integrated authentication via SPNEGO (Kerberos).

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#authentication
</string>
      <string id="Authentication_Delegated">Sites allowed to receive delegated credentials</string>
      <string id="Authentication_Delegated_Explain">Websites to which Thunderbird may delegate the authorization of the user.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#authentication
</string>
      <string id="Authentication_NTLM">Sites allowed to use NTLM</string>
      <string id="Authentication_NTLM_Explain">Websites which may use integrated authentication via NTLM.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#authentication
</string>
      <string id="Authentication_AllowNonFQDN">Allow integrated authentication for non-FQDN hosts</string>
      <string id="Authentication_AllowNonFQDN_Explain">Allows integrated authentication for hosts which are not given as fully qualified domain names.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#authentication
</string>
      <string id="Authentication_AllowProxies">Allow integrated authentication for proxies</string>
      <string id="Authentication_AllowProxies_Explain">Allows integrated authentication for proxy servers.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#authentication
</string>
      <string id="Authentication_Locked">Lock the integrated authentication settings</string>
      <string id="Authentication_Locked_Explain">Prevents the user from changing the integrated authentication settings. The settings are locked unless this is false.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#authentication
</string>
      <string id="Authentication_PrivateBrowsing">Integrated authentication in private browsing</string>
      <string id="Authentication_PrivateBrowsing_Explain">Enables integrated authentication in private browsing.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#authentication
</string>
      <string id="BackgroundAppUpdate">Background updates</string>
      <string id="BackgroundAppUpdate_Explain">Enable or disable the background updater.

Install application updates in the background, also when Thunderbird is not running (only on Windows). If this policy is enabled, updates may be installed in the background without asking the user (the operating system might still ask for approval). If it is disabled, no updates are installed while Thunderbird is not running. In both cases, the user can't change the setting. If updates are turned off with DisableAppUpdate, or automatic updates with AppAutoUpdate, this policy has no effect. If background updates don't run, check the requirements in this support article (https://support.mozilla.org/en-US/kb/enable-background-updates-thunderbird-windows).

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#backgroundappupdate
</string>
      <string id="BlockAboutAddons">Block Add-ons Manager</string>
      <string id="BlockAboutAddons_Explain">Block access to the Add-ons Manager (about:addons).

Users can no longer open it to install, remove, enable or disable add-ons, or to change their options. Add-ons can still be managed with the Extensions and ExtensionSettings policies.

If this policy is disabled or not configured, the Add-ons Manager is available.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#blockaboutaddons
</string>
      <string id="BlockAboutConfig">Block about:config</string>
      <string id="BlockAboutConfig_Explain">Block access to the about:config page.

Block access to about:config.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#blockaboutconfig
</string>
      <string id="BlockAboutProfiles">Block about:profiles</string>
      <string id="BlockAboutProfiles_Explain">Block access to the about:profiles page.

Block access to About Profiles (about:profiles).

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#blockaboutprofiles
</string>
      <string id="BlockAboutSupport">Block Troubleshooting Information</string>
      <string id="BlockAboutSupport_Explain">Block access to the about:support page.

Block access to Troubleshooting Information (about:support).

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#blockaboutsupport
</string>
      <string id="CaptivePortal">Captive portal detection</string>
      <string id="CaptivePortal_Explain">Enable or disable captive portal support.

Detect captive portals, the login pages of networks in hotels or airports which have to be passed before the internet can be used. If this policy is enabled, the detection is turned on. If it is disabled, it is turned off. In both cases, the user can't change the setting. If this policy is not configured, the user can change the setting.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#captiveportal
</string>
      <string id="Certificates_Install">Certificates to install</string>
      <string id="Certificates_Install_Explain">Adds certificates to the Thunderbird certificate store.

If only a filename is specified, Thunderbird searches for the file in the following locations:

- Windows
  - %USERPROFILE%\AppData\Local\Mozilla\Certificates
  - %USERPROFILE%\AppData\Roaming\Mozilla\Certificates
- macOS
  - /Library/Application Support/Mozilla/Certificates
  - ~/Library/Application Support/Mozilla/Certificates
- Linux
  - /usr/lib/mozilla/certificates
  - /usr/lib64/mozilla/certificates
  - ~/.mozilla/certificates

A fully qualified path can be used, including UNC paths. You should use the native path style for your operating system.

If you are specifying the path in the policies.json file on Windows, you need to escape your backslashes (\\) which means that for UNC paths, you need to escape both (\\\\). If you use group policy, you only need one backslash.

Certificates are installed using the trust string CT,CT,.

Binary (DER) and ASCII (PEM) certificates are both supported.

Environment variables like %USERPROFILE% are expanded.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#certificates
</string>
      <string id="Certificates_ImportEnterpriseRoots">Certificates of the operating system</string>
      <string id="Certificates_ImportEnterpriseRoots_Explain">Trust certificates that have been added to the operating system certificate store by a user or administrator.

Note: This policy only works on Windows and macOS. For Linux discussion, see bug 1600509 (https://bugzilla.mozilla.org/show_bug.cgi?id=1600509).

See https://support.mozilla.org/kb/setting-certificate-authorities-firefox for more detail.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#certificates
</string>
      <string id="Cookies_Allow">Sites which may always set cookies</string>
      <string id="Cookies_Allow_Explain">Cookies are always allowed for these origins (not domains). Each must include http or https.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#cookies
</string>
      <string id="Cookies_Block">Sites which may never set cookies</string>
      <string id="Cookies_Block_Explain">Cookies are always blocked for these origins (not domains). Each must include http or https.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#cookies
</string>
      <string id="Cookies_Default">Accept cookies</string>
      <string id="Cookies_Default_Explain">Determines whether cookies are accepted at all.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#cookies
</string>
      <string id="Cookies_AcceptThirdParty">Accept third-party cookies</string>
      <string id="Cookies_AcceptThirdParty_Explain">Determines how third-party cookies are handled.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#cookies
</string>
      <string id="Cookies_AcceptThirdParty_always">Always</string>
      <string id="Cookies_AcceptThirdParty_never">Never</string>
      <string id="Cookies_AcceptThirdParty_from_visited">From visited sites only</string>
      <string id="Cookies_ExpireAtSessionEnd">Keep cookies only until the end of the session (deprecated)</string>
      <string id="Cookies_ExpireAtSessionEnd_Explain">Deprecated.

This setting has no effect anymore.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#cookies
</string>
      <string id="Cookies_Locked">Lock the cookie preferences</string>
      <string id="Cookies_Locked_Explain">Prevents the user from changing cookie preferences.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#cookies
</string>
      <string id="DefaultDownloadDirectory">Default Download Directory</string>
      <string id="DefaultDownloadDirectory_Explain">Set the default download directory.

You can use ${home} for the native home directory.

Environment variables like %USERPROFILE% are expanded.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#defaultdownloaddirectory
</string>
      <string id="DisableAppUpdate">Disable Update</string>
      <string id="DisableAppUpdate_Explain">Prevent Thunderbird from updating.

Turn off application updates within Thunderbird.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#disableappupdate
</string>
      <string id="DisableBuiltinPDFViewer">Disable Built-in PDF Viewer (PDF.js)</string>
      <string id="DisableBuiltinPDFViewer_Explain">Disable PDF.js, the built-in PDF viewer in Thunderbird.

Disable the built in PDF viewer. PDF files are downloaded and sent externally.

For more information visit: https://thunderbird.github.io/policy-templates/policies/esr153/#disablebuiltinpdfviewer
</string>
